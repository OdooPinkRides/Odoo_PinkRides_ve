<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_pink_routemanager" model="res.groups.privilege">
        <field name="name">Pink RouteManager</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_pink_routemanager" model="res.groups">
        <field name="name">Gestionar empresas, conductores y viajes</field>
        <field name="privilege_id" ref="privilege_pink_routemanager"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('base.group_partner_manager'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin')), Command.link(ref('base.user_root'))]"/>
    </record>
    <record id="trip_company_rule" model="ir.rule">
        <field name="name">Viajes Pink: compañía Odoo permitida</field>
        <field name="model_id" ref="model_pink_routemanager_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
